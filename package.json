{
  "name": "accordos",
  "version": "1.0.0",
  "private": true,
  "description": "AccordOS: autonomous commercial execution desk on PayPal Sandbox",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "PAYPAL_REPLAY=1 tsx server/src/selftest.ts && tsx scripts/studio-adapter.test.ts && tsx scripts/paypal-retry.test.ts",
    "test:live": "tsx server/src/selftest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.8",
    "@bryntum/scheduler-react": "^7.3.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@paypal/agent-toolkit": {
      "mathjs": "15.2.0"
    }
  }
}
