# Leave PayPal keys empty to run in deterministic Replay mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) account email used as the invoice recipient.
PAYPAL_SANDBOX_BUYER_EMAIL=
# Optional: Claude parses briefs and narrates agent decisions when set.
ANTHROPIC_API_KEY=
# Optional: Claude model id. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=
# Optional: Channel3 product search. Fixture catalog is used when empty.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
PORT=8787

# Optional: public site address for link previews (Vercel and Render set their own)
# PUBLIC_URL=https://accordos.example.com
